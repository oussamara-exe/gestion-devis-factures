# ============================================
# Configuration Docker Compose - Variables d'environnement
# ============================================
# Copiez ce fichier vers .env et modifiez les valeurs selon vos besoins
# Ne commitez JAMAIS le fichier .env (il doit être dans .gitignore)

# --------------------------------------------
# Configuration MySQL
# --------------------------------------------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=gestion_devis_factures
MYSQL_USER=appuser
MYSQL_PASSWORD=apppassword
MYSQL_PORT=3306

# --------------------------------------------
# Configuration Backend (Spring Boot)
# --------------------------------------------
BACKEND_PORT=8080
BACKEND_URL=http://localhost:8080

# Configuration Spring Boot (optionnel - peut être surchargé par application.properties)
SPRING_JPA_SHOW_SQL=false
SPRING_PROFILES_ACTIVE=prod

# --------------------------------------------
# Configuration Frontend (React)
# --------------------------------------------
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# URL de l'API backend pour le frontend (utilisé par Vite)
VITE_API_URL=http://localhost:8080

# --------------------------------------------
# Configuration pour la Production
# --------------------------------------------
# Pour le déploiement en production, modifiez ces valeurs :
# BACKEND_URL=https://votre-backend.com
# FRONTEND_URL=https://votre-frontend.com
# VITE_API_URL=https://votre-backend.com
# SPRING_WEB_CORS_ALLOWED_ORIGINS=https://votre-frontend.com

